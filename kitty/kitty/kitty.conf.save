# Background matching your brain foreground #cdd6f4

# Make it look clean
background_opacity 0.7
dynamic_background_opacity yes
font_size 12.0

# Optional: remove window decorations for a sleek look
hide_window_decorations no

allow_remote_control yes
listen_on unix:/tmp/mykitty

map ctrl+shift+t launch --type=os-window bash -c '~/.local/bin/kitty-launch'
